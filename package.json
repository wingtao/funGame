{
  "name": "fungame",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter './apps/*' --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm lint:prepare && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "new": "node scripts/create-project.mjs",
    "lint:fix": "pnpm lint:prepare && eslint . --fix --max-warnings 0",
    "lint:prepare": "pnpm -r --if-present lint:prepare",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@fungame/config-eslint": "workspace:*",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
